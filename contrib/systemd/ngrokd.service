[Unit]
Description=ngrok server daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ngrok
Group=ngrok
ExecStart=/usr/local/bin/ngrokd -domain=example.com -tlsCrt=/etc/ngrok/tls.crt -tlsKey=/etc/ngrok/tls.key -adminAddr=127.0.0.1:9090
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target

