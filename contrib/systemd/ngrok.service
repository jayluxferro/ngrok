[Unit]
Description=ngrok client tunnel service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ngrok
Group=ngrok
ExecStart=/usr/local/bin/ngrok -config=/etc/ngrok/ngrok.yml start-all
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target

